{
  "name": "claude-analytics",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Query the Claude Code Analytics API from a CLI and a self-hosted React app, joined to a developer attributes CSV.",
  "workspaces": [
    "packages/*",
    "apps/cli",
    "apps/server",
    "apps/web"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build:core": "npm run build -w @claude-analytics/core",
    "build:web": "npm run build -w @claude-analytics/web",
    "build": "npm run build:core && npm run build:web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "cli": "node --import tsx apps/cli/src/index.ts",
    "dev": "npm run build:core && concurrently -n server,web -c blue,green \"node --import tsx --watch apps/server/src/index.ts\" \"npm run dev -w @claude-analytics/web\"",
    "start": "npm run build && node --import tsx apps/server/src/index.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.2",
    "concurrently": "^10.0.5",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "jsdom": "^30.1.1",
    "prettier": "^3.9.9",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.70.1",
    "vitest": "^5.0.1"
  }
}
