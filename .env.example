# ---- Claude Analytics Explorer config ----

# REQUIRED: Claude Enterprise Analytics API key (prefix sk-ant-api01-...).
# Created by the org primary owner in claude.ai > Organization settings > API,
# with the read:analytics scope. This is NOT a Console Admin key and NOT a
# standard Claude API key. It can read org-wide analytics, so it stays
# server-side only (never shipped to the browser).
ANTHROPIC_ANALYTICS_API_KEY=sk-ant-api01-...

# OPTIONAL: default path to the developer attributes CSV.
# Only requirement: an "email" column to join on. EVERY other column becomes a
# dimension you can group/break down by (e.g. Level, BU, Role, practiceArea) —
# nothing is hard-coded. The web UI can override this by uploading a CSV.
CSV_PATH=./export.csv

# OPTIONAL: path to a projects/teams YAML file for date-aware "who was on what
# project when" groupings (Project/Team/Client, split cost by overlap). See
# config/projects.sample.yaml for the shape. The web UI can override this by
# uploading a file.
PROJECTS_PATH=./config/projects.yaml

# OPTIONAL: where the local SQLite cache lives (default ./data/analytics.db).
DB_PATH=./data/analytics.db

# OPTIONAL: port the backend listens on (default 3000).
PORT=3000

# OPTIONAL: extra browser origins allowed to POST to the state-mutating
# endpoints (/api/sync, /api/csv, /api/projects). Comma-separated; a full
# origin, a bare host with optional port, or a "*."-prefixed subdomain
# wildcard. The server's own host is always allowed, so this is only needed
# when the browser's origin legitimately differs from the Host that Fastify
# sees — which is the case for:
#   - `npm run dev`: vite's proxy rewrites Host to 127.0.0.1:3000 while the
#     browser's Origin stays localhost:5173, so without this every POST 403s.
#   - a staging/preview deployment behind a proxy or CDN.
# Browsers omit the default port from Origin — write example.com, not
# example.com:443. A malformed entry fails at boot rather than being ignored.
ALLOWED_ORIGINS=http://localhost:5173,https://staging.example.com,*.preview.example.com
